%% Exclusive tiered store/load workflow.
sequenceDiagram
    autonumber
    participant Client
    participant Sched as Scheduler<br/>(SimpleCPUOffloadScheduler)
    participant Fast as Fast tier<br/>(BlockPool #0)
    participant Slow as Slow tier<br/>(BlockPool #1)
    participant Worker as Worker<br/>(SimpleCPUOffloadWorker)

    Client->>Sched: add_request(priority=p)
    Sched->>Sched: tier := _choose_tier(p)<br/>(p < threshold ⇒ fast, else slow)

    rect rgba(232,245,224,0.5)
        note over Sched,Worker: Store path (KV produced on GPU)
        Sched->>Sched: _prepare_eager_store_specs<br/>(emit one event per tier this step)
        Sched-->>Worker: SimpleCPUOffloadMetadata<br/>(store_cpu_tier=tier, store_blocks=…)
        Worker->>Fast: launch_copy(GPU→Fast)<br/>iff tier==fast
        Worker->>Slow: launch_copy(GPU→Slow)<br/>iff tier==slow
        Worker-->>Sched: completed_store_events
    end

    rect rgba(230,240,255,0.5)
        note over Sched,Worker: Load path (cache hit on prefix)
        Sched->>Fast: find_longest_cache_hit
        Sched->>Slow: find_longest_cache_hit
        Sched->>Sched: pick longer hit, record cpu_tier per block
        Sched-->>Worker: SimpleCPUOffloadMetadata<br/>(load_blocks=…, load_cpu_tiers=[…])
        Worker->>Fast: launch_copy(Fast→GPU)<br/>for tier-0 blocks
        Worker->>Slow: launch_copy(Slow→GPU)<br/>for tier-1 blocks
    end

    note over Fast,Slow: Each tier evicts independently using its own LRU.<br/>No demote / promote / cascade between tiers.
