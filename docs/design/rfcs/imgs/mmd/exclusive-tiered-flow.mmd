%% Sequence: scheduler calls MultiMediaOffloadingManager.prepare_store;
%% manager admits to FAST_CPU or SLOW_CPU based on req_context.priority;
%% worker dispatches by (src_type, dst_type) yielded from get_handlers().
%% See docs/design/rfcs/exclusive-tiered-caching.md
sequenceDiagram
    autonumber
    participant Sched as OffloadingConnectorScheduler
    participant MM as MultiMediaOffloadingManager
    participant Pol as PriorityAdmissionPolicy
    participant Fast as Fast CPUOffloadingManager
    participant Slow as Slow CPUOffloadingManager
    participant Worker as OffloadingConnectorWorker
    participant FH as Fast CpuGpuHandlers
    participant SH as Slow CpuGpuHandlers

    Note over Sched,SH: Store path — admission once per request
    Sched->>MM: prepare_store(keys, ReqContext(priority=0))
    MM->>Pol: choose(req_context)
    Pol-->>MM: Fast manager
    MM->>Fast: prepare_store(keys, req_context)
    Fast-->>MM: PrepareStoreOutput(spec=FastCpuLoadStoreSpec, ...)
    MM-->>Sched: PrepareStoreOutput
    Sched->>Worker: build_connector_meta with FastCpuLoadStoreSpec
    Worker->>FH: gpu_to_cpu_handler.start_transfer(...)
    FH-->>Worker: torch.Event
    Worker->>MM: complete_store(keys, success=True)

    Note over Sched,SH: Load path — fast first, then slow, longer prefix wins
    Sched->>MM: lookup(key, req_context)
    MM->>Fast: lookup(key)
    Fast-->>MM: True/False
    alt fast missed
        MM->>Slow: lookup(key)
        Slow-->>MM: True/False
    end
    MM-->>Sched: True/False/None
    Sched->>MM: prepare_load(keys, req_context)
    MM->>Slow: prepare_load(keys)
    Slow-->>MM: SlowCpuLoadStoreSpec(...)
    MM-->>Sched: SlowCpuLoadStoreSpec(...)
    Sched->>Worker: dispatch by (Slow → GPU)
    Worker->>SH: cpu_to_gpu_handler.start_transfer(...)
