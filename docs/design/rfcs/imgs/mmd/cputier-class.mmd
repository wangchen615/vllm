%% Class diagram: MultiMediaOffloadingManager + AdmissionPolicy +
%% SecondaryMemoryOffloadingSpec on top of OffloadingConnector primitives;
%% HostMemoryPoolManager + HmpmClient sit underneath as the shared substrate.
%% Filename kept for diff continuity; contents reflect the OffloadingConnector-based design.
%% See docs/design/rfcs/exclusive-tiered-caching.md
classDiagram
    class SecondaryMemoryOffloadingSpec {
        +int fast_blocks
        +int slow_blocks
        +int priority_threshold
        +str eviction_policy
        +bool hmpm_enabled
        +str placement_mode
        +get_manager() OffloadingManager
        +get_handlers() Iterator
    }

    class MultiMediaOffloadingManager {
        -OffloadingManager _fast
        -OffloadingManager _slow
        -AdmissionPolicy _admission
        -dict _owns
        +lookup(key, ctx) bool|None
        +prepare_load(keys, ctx) LoadStoreSpec
        +prepare_store(keys, ctx) PrepareStoreOutput
        +complete_store(keys, success) None
        +absorb_claimed_keys(keys, medium) None
    }

    class AdmissionPolicy {
        <<Protocol>>
        +choose(req_context) OffloadingManager
    }

    class PriorityAdmissionPolicy {
        +int threshold
        +choose(req_context) OffloadingManager
    }

    class CPUOffloadingManager {
        +int num_blocks
        +CachePolicy policy
        +medium: str
        +lookup(key, ctx) bool|None
        +prepare_store(keys, ctx) PrepareStoreOutput
        +complete_store(keys, success) None
        +take_events() Iterable
    }

    class CachePolicy {
        <<abstract>>
        +get(key)
        +touch(keys)
        +insert(key, block)
        +evict(n, protected)
    }

    class HmpmClient {
        +attach(deployment_id) AttachHandle
        +allocate(handle, medium, keys) AllocateResponse
        +free(handle, medium, ids) None
        +lookup_peer(handle, keys) list~PeerHit~
        +claim_orphan(handle, peer_id, keys) ClaimResponse
        +heartbeat() None
    }

    class HostMemoryPoolManager {
        +mmap region: bytes
        +allocation_table: dict
        +heartbeats: dict
        +on_attach(...) AttachHandle
        +on_allocate(...) AllocateResponse
        +on_lookup_peer(...) list~PeerHit~
        +on_claim_orphan(...) ClaimResponse
    }

    class HmpmSharedOffloadRegion {
        +HmpmClient client
        +str medium
        +int num_blocks
        +create_next_view(page_size) Tensor
        +cleanup() None
    }

    SecondaryMemoryOffloadingSpec --> MultiMediaOffloadingManager : creates
    MultiMediaOffloadingManager --> CPUOffloadingManager : wraps 2
    MultiMediaOffloadingManager --> AdmissionPolicy : delegates admission
    PriorityAdmissionPolicy ..|> AdmissionPolicy
    CPUOffloadingManager --> CachePolicy : owns
    SecondaryMemoryOffloadingSpec --> HmpmClient : uses if hmpm_enabled
    HmpmClient ..> HostMemoryPoolManager : RPC over UDS
    SecondaryMemoryOffloadingSpec --> HmpmSharedOffloadRegion : drops in for SharedOffloadRegion
    HmpmSharedOffloadRegion --> HmpmClient : reads pool slice

    note for MultiMediaOffloadingManager "Symmetric — no 'fast'-vs-'slow' asymmetry<br/>leaks anywhere except AdmissionPolicy.<br/>Replaced by InclusiveCascadeManager,<br/>HybridReplicateManager, ReplicateManager<br/>per placement_mode in resiliency RFC."
